NODE_ENV=production
PORT=8787
DATABASE_URL=postgresql://zhirox:change-me@127.0.0.1:5432/zhirox
APP_ORIGIN=https://pos.example.com
BOOTSTRAP_TOKEN=replace-with-64-random-characters
OFFLINE_LEASE_SECRET=replace-with-a-different-64-random-character-secret
MARKET_TIME_ZONE=Asia/Baghdad
TRUST_PROXY=1
DB_POOL_SIZE=10

AUTO_BACKUP=1
BACKUP_HOUR_LOCAL=2
BACKUP_DIR=/var/lib/zhirox/backups
BACKUP_RETENTION_FILES=30
BACKUP_ENCRYPTION_KEY_B64=replace-with-base64-of-32-random-bytes
